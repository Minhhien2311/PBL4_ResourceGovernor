@model IEnumerable<WebAdmin_ControlPlane.Models.ServerNode>
@{
    ViewData["Title"] = "Dashboard";
    var cache = ViewBag.Cache as WebAdmin_ControlPlane.Services.TelemetryCacheService;
}

<div class="card">
    <div class="card-header"><h3 class="card-title">Trạng thái các Server</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead>
                <tr>
                    <th>Node ID</th>
                    <th>IP Address</th>
                    <th>Trạng thái</th>
                    <th>CPU (%)</th>
                    <th>RAM (MB)</th>
                    <th>Processes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var node in Model)
                {
                    // Kiểm tra xem có nhận được heartbeat trong 15 giây qua không
                    bool isOnline = false;
                    WebAdmin_ControlPlane.Models.HeartbeatPayload hb = null;

                    if (cache != null && cache.LastHeartbeatTimes.ContainsKey(node.NodeId))
                    {
                        var lastTime = cache.LastHeartbeatTimes[node.NodeId];
                        if ((DateTime.Now - lastTime).TotalSeconds <= 15)
                        {
                            isOnline = true;
                            hb = cache.LatestHeartbeats[node.NodeId];
                        }
                    }

                    <tr>
                        <td><strong>@node.NodeId</strong></td>
                        <td>@node.IpAddress</td>
                        <td>
                            @if (isOnline)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Online</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Offline</span>
                            }
                        </td>
                        <td>@(isOnline ? hb.CPUUsagePercent.ToString("0.0") : "-")</td>
                        <td>@(isOnline ? $"{hb.UsedRAM} / {hb.TotalRAM}" : "-")</td>
                        <td>@(isOnline ? hb.ProcessCount.ToString() : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>