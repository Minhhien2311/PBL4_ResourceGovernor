@model IEnumerable<WebAdmin_ControlPlane.Models.EventLog>
@{
    ViewData["Title"] = "Nhật ký sự kiện";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Lịch sử áp dụng chính sách</h3>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Server (NodeId)</th>
                    <th>Hành động</th>
                    <th>Tiến trình</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td><span class="badge bg-secondary">@log.NodeId</span></td>
                            <td>@log.Action</td>
                            <td>@log.TargetProcess</td>
                            <td>
                                @if (log.Message.Contains("Thành công"))
                                {
                                    <span class="text-success"><i class="bi bi-check-circle"></i> @log.Message</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="bi bi-x-circle"></i> @log.Message</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center">Chưa có nhật ký nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>