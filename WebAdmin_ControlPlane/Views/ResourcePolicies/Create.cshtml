@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Ẩn/hiện trường theo loại chính sách
            function togglePolicyFields() {
                var type = $('#policyType').val();
                if (type === 'OS') {
                    $('#osFields').show();
                    $('#networkFields').hide();
                } else {
                    $('#osFields').hide();
                    $('#networkFields').show();
                }
            }
            togglePolicyFields();
            $('#policyType').change(togglePolicyFields);

            // Định dạng hiển thị: tên tiến trình (RAM: ... MB, CPU: ...% - user)
            function formatProcessLabel(proc) {
                var rawRam = (proc.ramMB !== undefined && proc.ramMB !== null) ? proc.ramMB : proc.RamMB;
                var ramText = (rawRam !== undefined && rawRam !== null && !isNaN(rawRam))
                    ? Number(rawRam).toFixed(1)
                    : '0.0';

                var rawCpu = (proc.cpuPercent !== undefined && proc.cpuPercent !== null) ? proc.cpuPercent : proc.CpuPercent;
                var cpuText = (rawCpu !== undefined && rawCpu !== null && !isNaN(rawCpu))
                    ? Number(rawCpu).toFixed(1) + '%'
                    : 'N/A';

                var userName = proc.user || proc.User || '';
                var userSuffix = userName ? ' - ' + userName : '';

                return (proc.name || proc.Name) + ' (RAM: ' + ramText + ' MB, CPU: ' + cpuText + userSuffix + ')';
            }

            var processDropdown = $('#processDropdown');

            function loadProcessesForServer(nodeId, preselectProcess, preselectUser) {
                $('#targetProcessInput').val(preselectProcess || '');
                $('#targetUserInput').val(preselectUser || '');
                processDropdown.prop('disabled', true).empty();

                if (!nodeId) {
                    processDropdown.append('<option value="">-- Vui lòng chọn Server trước --</option>');
                    return;
                }
                processDropdown.append('<option value="">-- Đang tải... --</option>');

                $.get('@Url.Action("GetProcessList", "ResourcePolicies")', { nodeId: nodeId })
                    .done(function (data) {
                        processDropdown.empty();
                        if ((!data || data.length === 0) && !preselectProcess) {
                            processDropdown.append('<option value="">(Server chưa báo tiến trình nào)</option>');
                            return;
                        }

                        processDropdown.append('<option value="">-- Chọn tiến trình --</option>');
                        var matchedPreselect = false;

                        if (data && data.length > 0) {
                            $.each(data, function (index, proc) {
                                var pName = proc.name || proc.Name;
                                var pUser = proc.user || proc.User || '';
                                var isMatch = preselectProcess && (pName === preselectProcess) && (!preselectUser || pUser === preselectUser);
                                if (isMatch) {
                                    matchedPreselect = true;
                                    $('#targetUserInput').val(pUser);
                                }

                                processDropdown.append(
                                    $('<option>')
                                        .val(pName)
                                        .attr('data-user', pUser)
                                        .prop('selected', isMatch)
                                        .text(formatProcessLabel(proc))
                                );
                            });
                        }

                        if (preselectProcess && !matchedPreselect) {
                            processDropdown.append(
                                $('<option>')
                                    .val(preselectProcess)
                                    .attr('data-user', preselectUser || '')
                                    .prop('selected', true)
                                    .text(preselectProcess + (preselectUser ? ' (' + preselectUser + ')' : ''))
                            );
                        }

                        processDropdown.prop('disabled', false);
                    })
                    .fail(function (xhr) {
                        processDropdown.empty().append(
                            $('<option>').val('').text('Lỗi: ' + (xhr.responseText || ('HTTP ' + xhr.status)))
                        );
                    });
            }

            // Khi người dùng đổi Server thủ công
            $('#serverDropdown').change(function () {
                loadProcessesForServer($(this).val(), '', '');
            });

            processDropdown.change(function () {
                var selected = $(this).find('option:selected');
                $('#targetProcessInput').val(selected.val());
                $('#targetUserInput').val(selected.data('user'));
            });

            // Nếu đi từ nút "Giới hạn" trên Dashboard sang -> tự tải danh sách và chọn sẵn tiến trình
            var initialNode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.NodeId ?? ""));
            var initialProcess = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.TargetProcess ?? ""));
            var initialUser = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.TargetUser ?? ""));

            if (initialNode) {
                $('#serverDropdown').val(initialNode);
                loadProcessesForServer(initialNode, initialProcess, initialUser);
            }
        });
    </script>
}