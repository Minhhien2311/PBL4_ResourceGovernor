@model WebAdmin_ControlPlane.Models.ResourcePolicy
@{
    ViewData["Title"] = "Tạo Luật RAM";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card card-primary">
            <div class="card-header"><h3 class="card-title">Gửi Luật tới Agent</h3></div>
            <form asp-action="Create">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label class="control-label">Chọn Server (Node)</label>
                        <select asp-for="NodeId" id="serverDropdown" class="form-control" asp-items="ViewBag.Servers">
                            <option value="">-- Chọn Server --</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="control-label">Chọn Tiến trình (từ Agent)</label>
                        <select id="processDropdown" class="form-control" disabled>
                            <option value="">-- Vui lòng chọn Server trước --</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="TargetProcess" class="control-label">Tên Tiến trình (Process)</label>
                        <input asp-for="TargetProcess" class="form-control" id="targetProcessInput" readonly required />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="TargetUser" class="control-label">User sở hữu</label>
                        <input asp-for="TargetUser" class="form-control" id="targetUserInput" readonly required />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="MaxRamMB" class="control-label">Giới hạn RAM (MB)</label>
                        <input asp-for="MaxRamMB" class="form-control" required />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="OsAction" class="control-label">Hành động</label>
                        <select asp-for="OsAction" class="form-control">
                            <option value="Pause">Pause</option>
                            <option value="Kill">Kill</option>
                        </select>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Áp dụng xuống Agent</button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var processDropdown = $('#processDropdown');

            $('#serverDropdown').change(function () {
                var nodeId = $(this).val();

                if (!nodeId) {
                    processDropdown.empty().append('<option value="">-- Vui lòng chọn Server trước --</option>').prop('disabled', true);
                    $('#targetProcessInput').val('');
                    $('#targetUserInput').val('');
                    return;
                }

                processDropdown.empty().append('<option value="">-- Đang tải... --</option>').prop('disabled', true);

                $.get('@Url.Action("GetProcessList", "ResourcePolicies")', { nodeId: nodeId }, function (data) {
                    processDropdown.empty();

                    if (data.length === 0) {
                        processDropdown.append('<option value="">-- Không có Process (đợi 5s để Agent gửi dữ liệu) --</option>');
                        return;
                    }

                    processDropdown.append('<option value="">-- Chọn tiến trình --</option>');
                    $.each(data, function (index, proc) {
                        processDropdown.append('<option value="' + proc.name + '" data-user="' + proc.user + '">'
                            + proc.name + ' (' + proc.ramMB + ' MB, user: ' + proc.user + ')</option>');
                    });
                    processDropdown.prop('disabled', false);
                }).fail(function () {
                    processDropdown.empty().append('<option value="">-- Lỗi kết nối API --</option>');
                });
            });

            processDropdown.change(function () {
                var selected = $(this).find('option:selected');
                $('#targetProcessInput').val(selected.val());
                $('#targetUserInput').val(selected.data('user'));
            });
        });
    </script>
}