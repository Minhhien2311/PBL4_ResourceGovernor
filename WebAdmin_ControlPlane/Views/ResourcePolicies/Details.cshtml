@model WebAdmin_ControlPlane.Models.ResourcePolicy
@{
    ViewData["Title"] = "Chi tiết Chính sách";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Thông tin Luật</h3></div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Server Áp Dụng</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary fs-6">@Model.NodeId</span></dd>

                    <dt class="col-sm-4">Tên Tiến trình</dt>
                    <dd class="col-sm-8 fs-5 text-primary">@Model.TargetProcess</dd>

                    <dt class="col-sm-4">User sở hữu</dt>
                    <dd class="col-sm-8 fs-5 text-primary">@Model.TargetUser</dd>

                    <dt class="col-sm-4">Giới hạn RAM (MB)</dt>
                    <dd class="col-sm-8 fs-5 text-danger">@Model.MaxRamMB</dd>

                    <dt class="col-sm-4">Hành động vượt ngưỡng</dt>
                    <dd class="col-sm-8">
                        @if (Model.OsAction == "Kill")
                        {
                            <span class="badge bg-danger fs-6">Kill</span>
                        }
                        else
                        {

                            <span class="badge bg-warning text-dark fs-6">Pause</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Chỉnh sửa</a>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</div>