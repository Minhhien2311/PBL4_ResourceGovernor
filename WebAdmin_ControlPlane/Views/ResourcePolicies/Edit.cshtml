                            <span asp-validation-for="ApplyToIp" class="text-danger"></span>
                        </div>
                    </div>

                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-warning">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Ẩn/hiện trường theo loại chính sách ngay khi load trang
            function togglePolicyFields() {
                var type = $('#policyType').val();
                if (type === 'OS') {
                    $('#osFields').show();
                    $('#networkFields').hide();
                } else {
                    $('#osFields').hide();
                    $('#networkFields').show();
                }
            }
            togglePolicyFields();
            $('#policyType').change(togglePolicyFields);

            // Định dạng hiển thị: tên tiến trình (RAM: ... MB, CPU: ...% - user)
            function formatProcessLabel(proc) {
                var rawRam = (proc.ramMB !== undefined && proc.ramMB !== null) ? proc.ramMB : proc.RamMB;
                var ramText = (rawRam !== undefined && rawRam !== null && !isNaN(rawRam))
                    ? Number(rawRam).toFixed(1)
                    : '0.0';

                var rawCpu = (proc.cpuPercent !== undefined && proc.cpuPercent !== null) ? proc.cpuPercent : proc.CpuPercent;
                var cpuText = (rawCpu !== undefined && rawCpu !== null && !isNaN(rawCpu))
                    ? Number(rawCpu).toFixed(1) + '%'
                    : 'N/A';

                var userName = proc.user || proc.User || '';
                var userSuffix = userName ? ' - ' + userName : '';

                return (proc.name || proc.Name) + ' (RAM: ' + ramText + ' MB, CPU: ' + cpuText + userSuffix + ')';
            }

            var processDropdown = $('#processDropdown');
            var currentTargetProcess = '@Model.TargetProcess';
            var currentTargetUser = '@Model.TargetUser';

            function loadProcessesForNode(nodeId, preserveCurrentSelection) {
                if (!nodeId) return;

                if (!preserveCurrentSelection) {
                    $('#targetProcessInput').val('');
                    $('#targetUserInput').val('');
                }

                processDropdown.prop('disabled', true).empty()
                    .append('<option value="">-- Đang tải... --</option>');

                $.get('@Url.Action("GetProcessList", "ResourcePolicies")', { nodeId: nodeId })
                    .done(function (data) {
                        processDropdown.empty().append('<option value="">-- Chọn tiến trình --</option>');
                        var foundCurrent = false;

                        if (data && data.length > 0) {
                            $.each(data, function (index, proc) {
                                var pName = proc.name || proc.Name;
                                var pUser = proc.user || proc.User || '';
                                var isSelected = preserveCurrentSelection && (pName === currentTargetProcess);
                                if (isSelected) foundCurrent = true;

                                processDropdown.append(
                                    $('<option>')
                                        .val(pName)
                                        .attr('data-user', pUser)
                                        .prop('selected', isSelected)
                                        .text(formatProcessLabel(proc))
                                );
                            });
                        }

                        // Giữ lại tiến trình đang cấu hình nếu tiến trình đó hiện không nằm trong top 50
                        if (preserveCurrentSelection && currentTargetProcess && !foundCurrent) {
                            processDropdown.append(
                                $('<option>')
                                    .val(currentTargetProcess)
                                    .attr('data-user', currentTargetUser)
                                    .prop('selected', true)
                                    .text(currentTargetProcess + ' (Đang áp dụng - ' + currentTargetUser + ')')
                            );
                        }

                        processDropdown.prop('disabled', false);
                    })
                    .fail(function () {
                        processDropdown.empty();
                        if (preserveCurrentSelection && currentTargetProcess) {
                            processDropdown.append(
                                $('<option>')
                                    .val(currentTargetProcess)
                                    .attr('data-user', currentTargetUser)
                                    .prop('selected', true)
                                    .text(currentTargetProcess)
                            );
                        } else {
                            processDropdown.append('<option value="">-- Không tải được danh sách tiến trình --</option>');
                        }
                        processDropdown.prop('disabled', false);
                    });
            }

            // Tự động tải thông số RAM & CPU của Node hiện tại khi mở trang Edit
            var initialNodeId = $('#serverDropdown').val();
            if (initialNodeId && $('#policyType').val() === 'OS') {
                loadProcessesForNode(initialNodeId, true);
            }

            // Khi đổi sang server khác
            $('#serverDropdown').change(function () {
                loadProcessesForNode($(this).val(), false);
            });

            processDropdown.change(function () {
                var selected = $(this).find('option:selected');
                $('#targetProcessInput').val(selected.val());
                $('#targetUserInput').val(selected.data('user'));
            });
        });
    </script>
}