}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card card-warning">
            <div class="card-header"><h3 class="card-title">Cập nhật Chính sách</h3></div>
            <form asp-action="Edit">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-3">
                        <label class="control-label">Chọn Server (Node)</label>
                        <select asp-for="NodeId" id="serverDropdown" class="form-control" asp-items="ViewBag.Servers">
                            <option value="">-- Chọn Server --</option>
                        </select>
                        <span asp-validation-for="NodeId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PolicyType" class="control-label">Loại Chính Sách</label>
                        <select asp-for="PolicyType" class="form-control" id="policyType">
                            <option value="OS">Quản lý RAM / CPU (OS)</option>
                            <option value="NETWORK">Giới hạn Băng thông (Network)</option>
                        </select>
                    </div>

                    <!-- KHU VỰC OS (RAM/CPU) -->
                    <div id="osFields">
                        <div class="form-group mb-3">
                            <label class="control-label">Chọn Tiến trình (từ Agent)</label>
                            <select id="processDropdown" class="form-control">
                                <option value="@Model.TargetProcess" selected>@Model.TargetProcess</option>
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="TargetProcess" class="control-label"></label>
                            <input asp-for="TargetProcess" class="form-control" id="targetProcessInput" readonly />
                            <span asp-validation-for="TargetProcess" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="TargetUser" class="control-label"></label>
                            <input asp-for="TargetUser" class="form-control" id="targetUserInput" readonly />
                            <span asp-validation-for="TargetUser" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="MaxRamMB" class="control-label"></label>
                                <input asp-for="MaxRamMB" class="form-control" />
                                <span asp-validation-for="MaxRamMB" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="MaxCpuPercent" class="control-label"></label>
                                <input asp-for="MaxCpuPercent" type="number" class="form-control" />
                                <span asp-validation-for="MaxCpuPercent" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group form-check mb-3">
                            <input asp-for="ReclaimRam" class="form-check-input" type="checkbox" />
                            <label class="form-check-label" asp-for="ReclaimRam"></label>
                        </div>
                    </div>

                    <!-- KHU VỰC NETWORK (Băng thông) -->
                    <div id="networkFields" style="display:none;">
                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="TargetPort" class="control-label"></label>
                                <input asp-for="TargetPort" type="number" class="form-control" />
                                <span asp-validation-for="TargetPort" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="MaxBandwidthKbps" class="control-label"></label>
                                <input asp-for="MaxBandwidthKbps" type="number" class="form-control" />
                                <span asp-validation-for="MaxBandwidthKbps" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="ApplyToIp" class="control-label"></label>
                            <input asp-for="ApplyToIp" class="form-control" />
                            <span asp-validation-for="ApplyToIp" class="text-danger"></span>
                        </div>
                    </div>

                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-warning">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Ẩn/hiện trường theo loại chính sách ngay khi load trang
            function togglePolicyFields() {
                var type = $('#policyType').val();
                if (type === 'OS') {
                    $('#osFields').show();
                    $('#networkFields').hide();
                } else {
                    $('#osFields').hide();
                    $('#networkFields').show();
                }
            }
            togglePolicyFields();
            $('#policyType').change(togglePolicyFields);

            // Load process list (nếu đổi server)
            var processDropdown = $('#processDropdown');
            $('#serverDropdown').change(function () {
                var nodeId = $(this).val();
                if (!nodeId) return;

                processDropdown.empty().append('<option value="">-- Đang tải... --</option>');
                $.get('@Url.Action("GetProcessList", "ResourcePolicies")', { nodeId: nodeId }, function (data) {
                    processDropdown.empty().append('<option value="">-- Chọn tiến trình --</option>');
                    $.each(data, function (index, proc) {
                        var isSelected = (proc.name === '@Model.TargetProcess') ? 'selected' : '';
                        processDropdown.append('<option value="' + proc.name + '" data-user="' + proc.user + '" ' + isSelected + '>'
                            + proc.name + ' (' + proc.ramMB + ' MB, ' + proc.user + ')</option>');
                    });
                });
            });

            processDropdown.change(function () {
                var selected = $(this).find('option:selected');
                $('#targetProcessInput').val(selected.val());
                $('#targetUserInput').val(selected.data('user'));
            });
        });
    </script>
} *@

