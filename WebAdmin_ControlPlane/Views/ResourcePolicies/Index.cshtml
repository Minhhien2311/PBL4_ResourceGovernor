@model IEnumerable<WebAdmin_ControlPlane.Models.ResourcePolicy>
@{
    ViewData["Title"] = "Danh sách Chính sách";
}

<!-- THÔNG BÁO THÀNH CÔNG / THẤT BẠI -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Danh sách Luật</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Tạo mới</a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead>
                <tr>
                    <th>Server (NodeId)</th>
                    <th>Tiến trình</th>
                    <th>User</th>
                    <th>Giới hạn RAM</th>
                    <th>Hành động</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@item.NodeId</span></td>
                            <td>@item.TargetProcess</td>
                            <td>@item.TargetUser</td>
                            <td>@item.MaxRamMB MB</td>
                            <td>
                                @if (item.OsAction == "Kill")
                                {
                                    <span class="badge bg-danger">Kill</span>
                                }
                                else
                                {

                                    <span class="badge bg-warning text-dark">Pause</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Chi tiết</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center">Chưa có luật nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>