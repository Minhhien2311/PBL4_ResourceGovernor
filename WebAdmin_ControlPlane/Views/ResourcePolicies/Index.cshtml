@model IEnumerable<WebAdmin_ControlPlane.Models.ResourcePolicy>
@{
    ViewData["Title"] = "Danh sách Chính sách";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Danh sách Luật</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Tạo mới</a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead>
                <tr>
                    <th>Server</th>
                    <th>Loại</th>
                    <th>Mục tiêu (Process / Port)</th>
                    <th>User / IP</th>
                    <th>Giới hạn</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@item.NodeId</span></td>
                            <td>
                                @if (item.PolicyType == "NETWORK")
                                {
                                    <span class="badge bg-info">Network</span>
                                }
                                else
                                {

                                    <span class="badge bg-primary">OS</span>
                                }
                            </td>
                            <td>
                                @if (item.PolicyType == "NETWORK")
                                {
                                    <span>Port @item.TargetPort</span>
                                }
                                else
                                {

                                    <span>@item.TargetProcess</span>
                                }
                            </td>
                            <td>
                                @if (item.PolicyType == "NETWORK")
                                {
                                    <span>@item.ApplyToIp</span>
                                }
                                else
                                {

                                    <span>@item.TargetUser</span>
                                }
                            </td>
                            <td>
                                @if (item.PolicyType == "NETWORK")
                                {
                                    <span>@item.MaxBandwidthKbps Kbps</span>
                                }
                                else
                                {

                                    <span>@item.MaxRamMB MB / @item.MaxCpuPercent%</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center">Chưa có luật nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>