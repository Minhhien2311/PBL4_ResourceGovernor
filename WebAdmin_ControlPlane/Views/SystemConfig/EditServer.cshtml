@model WebAdmin_ControlPlane.Models.ServerNode
@{
    ViewData["Title"] = "Sửa thông tin Server";
}

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">Sửa thông tin Server: @Model.NodeId</h3>
            </div>
            <form asp-action="EditServer" method="post">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label class="control-label">Node ID (Không thể thay đổi)</label>
                        <!-- readonly để không cho phép sửa khóa chính -->
                        <input asp-for="NodeId" class="form-control" readonly style="background-color: #e9ecef;" />
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="IpAddress" class="control-label"></label>
                        <input asp-for="IpAddress" class="form-control" required />
                        <span asp-validation-for="IpAddress" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Port" class="control-label"></label>
                        <input asp-for="Port" type="number" class="form-control" required />
                        <span asp-validation-for="Port" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="AuthToken" class="control-label"></label>
                        <input asp-for="AuthToken" class="form-control" required />
                        <span asp-validation-for="AuthToken" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-warning">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}