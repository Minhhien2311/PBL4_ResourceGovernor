@model WebAdmin_ControlPlane.Models.SystemConfig
@{
    ViewData["Title"] = "Cấu hình & Trạng thái Hệ thống";
    var servers = ViewBag.Servers as List<WebAdmin_ControlPlane.Models.ControllerServerInfo>;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- CỘT TRÁI: FORM CẤU HÌNH CONTROLLER -->
    <div class="col-md-4">
        <div class="card card-primary">
            <div class="card-header"><h3 class="card-title">Cấu hình Controller</h3></div>
            <form asp-action="SaveConfig" method="post">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-3">
                        <label asp-for="ControllerIP" class="control-label"></label>
                        <input asp-for="ControllerIP" class="form-control" placeholder="VD: 192.168.1.20" required />
                        <span asp-validation-for="ControllerIP" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="ControllerPort" class="control-label"></label>
                        <input asp-for="ControllerPort" class="form-control" type="number" required />
                        <span asp-validation-for="ControllerPort" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="ControllerToken" class="control-label"></label>
                        <input asp-for="ControllerToken" class="form-control" placeholder="Mã bảo mật HMAC" required />
                        <span asp-validation-for="ControllerToken" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Lưu Cấu Hình</button>
                </div>
            </form>
        </div>
    </div>

    <!-- CỘT PHẢI: BẢNG DANH SÁCH SERVER TỪ CONTROLLER -->
    <div class="col-md-8">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-hdd-network"></i> Danh sách Server (Từ Controller)</h3>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr>
                            <th>Node ID</th>
                            <th>IP</th>
                            <th>Trạng thái</th>
                            <th>CPU (%)</th>
                            <th>RAM (MB)</th>
                            <th>Processes</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (servers != null && servers.Any())
                        {
                            @foreach (var s in servers)
                            {
                                <tr>
                                    <td><strong>@s.NodeId</strong></td>
                                    <td>@s.Ip</td>
                                    <td>
                                        <span class="badge @(s.State == "ONLINE" ? "bg-success" : "bg-danger")">@s.State</span>
                                    </td>
                                    <td>@s.CPUUsagePercent.ToString("0.0")</td>
                                    <td>@s.UsedRAM / @s.TotalRAM</td>
                                    <td>@s.ProcessCount</td>
                                    <td>@s.Note</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center">Không có Server nào kết nối hoặc mất kết nối Controller.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>